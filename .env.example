# Server-side only. Never expose this key with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Required for production. Use the public HTTPS origin without a path.
# Local example: http://localhost:3000
APP_URL=http://localhost:3000

# Optional. Must support image and PDF inputs through the Responses API.
OPENAI_MODEL=gpt-4.1-mini

# Optional. Model used by the credit-backed custom theme designer.
OPENAI_THEME_MODEL=gpt-4.1-mini

# Optional. Model used by the one-click product image assistant.
OPENAI_IMAGE_MODEL=gpt-image-1

# Optional. Defaults to .data/easyqr.db for local development.
# Production must use an absolute path on persistent storage.
DATABASE_PATH=

# Production backup settings. BACKUP_DIR defaults to a backups directory next
# to DATABASE_PATH. The automatic Docker worker uses these values.
BACKUP_DIR=
BACKUP_RETENTION_DAYS=14
BACKUP_MAX_FILES=30
BACKUP_INTERVAL_HOURS=24

# Production normally requires OPENAI_API_KEY. Set this explicitly to true only
# for a staging/demo deployment that intentionally uses demo AI responses.
ALLOW_DEMO_MODE=false

# Local development can print password-reset links in the server terminal.
# Production should use `resend` with a verified sender address.
EMAIL_DELIVERY_MODE=log
RESEND_API_KEY=
EMAIL_FROM="easyqr <no-reply@example.com>"
